@@ -0,0 +1,52 @@
+/*
+ * Copyright (C) 2025 Intel Corporation
+ *
+ * SPDX-License-Identifier: MIT
+ *
+ */
+
+#include "level_zero/core/source/cmdlist/launch_kernel_probe.h"
+
+#include "shared/source/device/device.h"
+#include "shared/source/helpers/usdt_probes.h"
+#include "shared/source/kernel/kernel_descriptor.h"
+#include "shared/source/memory_manager/gfx_partition.h"
+#include "shared/source/memory_manager/graphics_allocation.h"
+#include "shared/source/memory_manager/memory_manager.h"
+
+#include "level_zero/core/source/device/device.h"
+#include "level_zero/core/source/kernel/kernel.h"
+#include "level_zero/core/source/module/module_imp.h"
+
+namespace L0 {
+
+void emitLaunchKernelProbe(Kernel *kernel, Device *device) {
+    if (!LEVEL_ZERO_LAUNCH_KERNEL_ENABLED()) {
+        return;
+    }
+
+    auto module = static_cast<ModuleImp *>(kernel->getModule());
+    auto isaAllocation = kernel->getIsaAllocation();
+    if (module == nullptr || isaAllocation == nullptr) {
+        return;
+    }
+
+    const uint64_t kernelStart = isaAllocation->getGpuAddress() + kernel->getIsaOffsetInParentAllocation();
+    const uint64_t kernelSize = kernel->getImmutableData()->getIsaSize();
+    const auto &kernelName = kernel->getKernelDescriptor().kernelMetadata.kernelName;
+
+    auto *neoDevice = device->getNEODevice();
+    const uint64_t iba = neoDevice->getMemoryManager()
+                             ->getGfxPartition(neoDevice->getRootDeviceIndex())
+                             ->getHeapBase(NEO::HeapIndex::heapInternalDeviceMemory);
+
+    LEVEL_ZERO_LAUNCH_KERNEL(iba,
+                             kernelStart,
+                             kernelSize,
+                             reinterpret_cast<uintptr_t>(kernelName.c_str()),
+                             module->getModuleDebugHash(),
+                             reinterpret_cast<uintptr_t>(module->getModuleDebugElfPtr()),
+                             static_cast<uint64_t>(module->getModuleDebugElfSize()));
+}
+
+} // namespace L0
