+# USDT probes via SystemTap's dtrace wrapper, Linux only, opt-in.
+# Generates probes_generated.{h,o} from probes.d; the .o is linked into the
+# shared lib so the probe semaphores and SDT notes end up in the final image.
+if(NEO_ENABLE_USDT_PROBES)
+  if(NOT UNIX)
+    message(FATAL_ERROR "NEO_ENABLE_USDT_PROBES is only supported on Linux.")
+  endif()
+  find_program(NEO_DTRACE_EXECUTABLE dtrace)
+  include(CheckIncludeFile)
+  check_include_file(sys/sdt.h NEO_HAVE_SYS_SDT_H)
+  if(NOT NEO_DTRACE_EXECUTABLE OR NOT NEO_HAVE_SYS_SDT_H)
+    message(FATAL_ERROR
+      "NEO_ENABLE_USDT_PROBES=ON but required tooling is missing "
+      "(dtrace=${NEO_DTRACE_EXECUTABLE}, sys/sdt.h=${NEO_HAVE_SYS_SDT_H}). "
+      "Install systemtap-sdt-dev (Debian/Ubuntu) or systemtap-sdt-devel (RHEL/Fedora).")
+  endif()
+  set(NEO_HAVE_USDT_PROBES TRUE)
+  set(NEO_USDT_PROBES_D ${CMAKE_CURRENT_SOURCE_DIR}/os_interface/linux/probes.d)
+  set(NEO_USDT_PROBES_GEN_DIR ${NEO_BUILD_DIR}/shared/source/os_interface/linux)
+  set(NEO_USDT_PROBES_GEN_H ${NEO_USDT_PROBES_GEN_DIR}/probes_generated.h)
+  set(NEO_USDT_PROBES_GEN_O ${NEO_USDT_PROBES_GEN_DIR}/probes_generated.o)
+  add_custom_command(
+    OUTPUT ${NEO_USDT_PROBES_GEN_H} ${NEO_USDT_PROBES_GEN_O}
+    COMMAND ${CMAKE_COMMAND} -E make_directory ${NEO_USDT_PROBES_GEN_DIR}
+    COMMAND ${NEO_DTRACE_EXECUTABLE} -h -s ${NEO_USDT_PROBES_D} -o ${NEO_USDT_PROBES_GEN_H}
+    COMMAND ${NEO_DTRACE_EXECUTABLE} -G -s ${NEO_USDT_PROBES_D} -o ${NEO_USDT_PROBES_GEN_O}
+    DEPENDS ${NEO_USDT_PROBES_D}
+    COMMENT "Generating USDT probes from probes.d"
+    VERBATIM
+  )
+  set_source_files_properties(
+    ${NEO_USDT_PROBES_GEN_H} ${NEO_USDT_PROBES_GEN_O}
+    PROPERTIES GENERATED TRUE EXTERNAL_OBJECT TRUE
+  )
+  message(STATUS "USDT probes enabled (${NEO_DTRACE_EXECUTABLE})")
+endif()
+
 set(NEO_CORE_COMPILE_DEFS "")
 set(CORE_SOURCES ${CORE_SRCS_COREX_ALL_BASE})
+if(NEO_HAVE_USDT_PROBES)
+  list(APPEND CORE_SOURCES ${NEO_USDT_PROBES_D} ${NEO_USDT_PROBES_GEN_H} ${NEO_USDT_PROBES_GEN_O})
+endif()
 
 add_subdirectories()
 
